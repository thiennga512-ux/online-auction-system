<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>

<TabPane tabClosingPolicy="UNAVAILABLE" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
         fx:controller="com.Controller.SellerDashboardController"
         style="-fx-background-color: transparent;"
         styleClass="seller-tab-pane">
    <tabs>
        <!-- ====== TAB 1: ĐĂNG SẢN PHẨM ====== -->
        <Tab text="📦 Đăng Sản Phẩm" style="-fx-background-color: transparent;"
             styleClass="seller-tab">
            <ScrollPane fitToWidth="true" fitToHeight="true"
                style="-fx-background-color: transparent; -fx-background: transparent;">
                <VBox spacing="24" alignment="TOP_CENTER"
                      style="-fx-background-color: transparent; -fx-padding: 28 40 40 40;">

                    <!-- Header Banner -->
                    <VBox alignment="CENTER" spacing="6"
                          style="-fx-background-color: #1f2937; -fx-background-radius: 14; -fx-padding: 28 20 24 20; -fx-max-width: 860; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.35), 12, 0, 0, 4);">
                        <Label text="📦 Đăng Sản Phẩm Mới"
                               style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #ffffff;" />
                        <Label text="Điền đầy đủ thông tin bên dưới để đăng sản phẩm lên hệ thống đấu giá"
                               style="-fx-font-size: 13px; -fx-text-fill: #9ca3af;" />
                    </VBox>

                    <!-- Main Form Card -->
                    <VBox spacing="20" alignment="TOP_CENTER"
                          style="-fx-background-color: #1f2937; -fx-background-radius: 14; -fx-padding: 28 32 32 32; -fx-max-width: 860; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.35), 12, 0, 0, 4); -fx-border-color: rgba(59,130,246,0.06); -fx-border-radius: 14; -fx-border-width: 1;">

                        <!-- ===== THÔNG TIN CƠ BẢN ===== -->
                        <Label text="THÔNG TIN CƠ BẢN"
                               style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #93c5fd; -fx-padding: 0 0 4 0;" />
                        <Region style="-fx-background-color: #374151; -fx-min-height: 1; -fx-max-height: 1; -fx-padding: 0;" />

                        <GridPane hgap="18" vgap="16"
                                  style="-fx-padding: 8 0 4 0; -fx-max-width: 780;">
                            <Label text="Danh mục:" GridPane.columnIndex="0" GridPane.rowIndex="0"
                                   style="-fx-font-size: 14px; -fx-text-fill: #d1d5db; -fx-font-weight: 500; -fx-min-width: 150; -fx-alignment: CENTER_RIGHT;" />
                            <ComboBox fx:id="categoryComboBox" promptText="Chọn danh mục sản phẩm"
                                      GridPane.columnIndex="1" GridPane.rowIndex="0" prefWidth="480"
                                      style="-fx-pref-height: 40;" />

                            <Label text="Tên sản phẩm:" GridPane.columnIndex="0" GridPane.rowIndex="1"
                                   style="-fx-font-size: 14px; -fx-text-fill: #d1d5db; -fx-font-weight: 500; -fx-min-width: 150; -fx-alignment: CENTER_RIGHT;" />
                            <TextField fx:id="nameField" promptText="Nhập tên sản phẩm"
                                       GridPane.columnIndex="1" GridPane.rowIndex="1" prefWidth="480"
                                       style="-fx-pref-height: 40;" />

                            <Label text="Mô tả chi tiết:" GridPane.columnIndex="0" GridPane.rowIndex="2"
                                   style="-fx-font-size: 14px; -fx-text-fill: #d1d5db; -fx-font-weight: 500; -fx-min-width: 150; -fx-alignment: TOP_RIGHT; -fx-padding: 4 0 0 0;" />
                            <TextArea fx:id="descriptionField" promptText="Nhập mô tả chi tiết về sản phẩm..."
                                      GridPane.columnIndex="1" GridPane.rowIndex="2" prefWidth="480" prefHeight="90" wrapText="true"
                                      style="-fx-pref-height: 90;" />

                            <Label text="Giá khởi điểm:" GridPane.columnIndex="0" GridPane.rowIndex="3"
                                   style="-fx-font-size: 14px; -fx-text-fill: #d1d5db; -fx-font-weight: 500; -fx-min-width: 150; -fx-alignment: CENTER_RIGHT;" />
                            <TextField fx:id="basePriceField" promptText="VD: 1,000,000 VND"
                                       GridPane.columnIndex="1" GridPane.rowIndex="3" prefWidth="480"
                                       style="-fx-pref-height: 40;" />

                            <Label text="Bước giá tối thiểu:" GridPane.columnIndex="0" GridPane.rowIndex="4"
                                   style="-fx-font-size: 14px; -fx-text-fill: #d1d5db; -fx-font-weight: 500; -fx-min-width: 150; -fx-alignment: CENTER_RIGHT;" />
                            <TextField fx:id="minIncrementField" promptText="VD: 50,000 VND"
                                       GridPane.columnIndex="1" GridPane.rowIndex="4" prefWidth="480"
                                       style="-fx-pref-height: 40;" />

                            <Label text="Image URL:" GridPane.columnIndex="0" GridPane.rowIndex="5"
                                   style="-fx-font-size: 14px; -fx-text-fill: #d1d5db; -fx-font-weight: 500; -fx-min-width: 150; -fx-alignment: CENTER_RIGHT;" />
                            <HBox spacing="10" alignment="CENTER_LEFT"
                                  GridPane.columnIndex="1" GridPane.rowIndex="5" prefWidth="480">
                                <TextField fx:id="imageUrlField" promptText="https://example.com/image.png"
                                           HBox.hgrow="ALWAYS" style="-fx-pref-height: 40;" />
                                <Button text="📁 Chọn ảnh" fx:id="btnBrowseImage" onAction="#handleChooseImage"
                                        style="-fx-pref-height: 40;" />
                            </HBox>
                        </GridPane>

                        <!-- ===== THÔNG TIN CHI TIẾT ===== -->
                        <Label text="THÔNG TIN CHI TIẾT"
                               style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #93c5fd; -fx-padding: 8 0 4 0;" />
                        <Region style="-fx-background-color: #374151; -fx-min-height: 1; -fx-max-height: 1; -fx-padding: 0;" />

                        <!-- Electronics Fields -->
                        <GridPane fx:id="electronicsGrid" hgap="18" vgap="16" managed="true" visible="true"
                                  style="-fx-padding: 8 0 4 0; -fx-max-width: 780;">
                            <Label text="Thương hiệu:" GridPane.columnIndex="0" GridPane.rowIndex="0"
                                   style="-fx-font-size: 14px; -fx-text-fill: #d1d5db; -fx-font-weight: 500; -fx-min-width: 150; -fx-alignment: CENTER_RIGHT;" />
                            <TextField fx:id="brandField" promptText="VD: Apple, Samsung..."
                                      GridPane.columnIndex="1" GridPane.rowIndex="0" prefWidth="480"
                                      style="-fx-pref-height: 40;" />

                            <Label text="Model:" GridPane.columnIndex="0" GridPane.rowIndex="1"
                                   style="-fx-font-size: 14px; -fx-text-fill: #d1d5db; -fx-font-weight: 500; -fx-min-width: 150; -fx-alignment: CENTER_RIGHT;" />
                            <TextField fx:id="modelField" promptText="VD: iPhone 14 Pro"
                                      GridPane.columnIndex="1" GridPane.rowIndex="1" prefWidth="480"
                                      style="-fx-pref-height: 40;" />

                            <Label text="Bảo hành (tháng):" GridPane.columnIndex="0" GridPane.rowIndex="2"
                                   style="-fx-font-size: 14px; -fx-text-fill: #d1d5db; -fx-font-weight: 500; -fx-min-width: 150; -fx-alignment: CENTER_RIGHT;" />
                            <TextField fx:id="warrantyField" promptText="VD: 12"
                                      GridPane.columnIndex="1" GridPane.rowIndex="2" prefWidth="480"
                                      style="-fx-pref-height: 40;" />

                            <Label text="Tình trạng:" GridPane.columnIndex="0" GridPane.rowIndex="3"
                                   style="-fx-font-size: 14px; -fx-text-fill: #d1d5db; -fx-font-weight: 500; -fx-min-width: 150; -fx-alignment: CENTER_RIGHT;" />
                            <ComboBox fx:id="conditionComboBox" promptText="Chọn tình trạng"
                                      GridPane.columnIndex="1" GridPane.rowIndex="3" prefWidth="480"
                                      style="-fx-pref-height: 40;" />
                        </GridPane>

                        <!-- Art Fields -->
                        <GridPane fx:id="artGrid" hgap="18" vgap="16" managed="false" visible="false"
                                  style="-fx-padding: 8 0 4 0; -fx-max-width: 780;">
                            <Label text="Nghệ sĩ:" GridPane.columnIndex="0" GridPane.rowIndex="0"
                                   style="-fx-font-size: 14px; -fx-text-fill: #d1d5db; -fx-font-weight: 500; -fx-min-width: 150; -fx-alignment: CENTER_RIGHT;" />
                            <TextField fx:id="artistNameField" promptText="VD: Leonardo da Vinci"
                                      GridPane.columnIndex="1" GridPane.rowIndex="0" prefWidth="480"
                                      style="-fx-pref-height: 40;" />

                            <Label text="Năm sáng tác:" GridPane.columnIndex="0" GridPane.rowIndex="1"
                                   style="-fx-font-size: 14px; -fx-text-fill: #d1d5db; -fx-font-weight: 500; -fx-min-width: 150; -fx-alignment: CENTER_RIGHT;" />
                            <TextField fx:id="creationYearField" promptText="VD: 1503"
                                      GridPane.columnIndex="1" GridPane.rowIndex="1" prefWidth="480"
                                      style="-fx-pref-height: 40;" />

                            <Label text="Chất liệu:" GridPane.columnIndex="0" GridPane.rowIndex="2"
                                   style="-fx-font-size: 14px; -fx-text-fill: #d1d5db; -fx-font-weight: 500; -fx-min-width: 150; -fx-alignment: CENTER_RIGHT;" />
                            <TextField fx:id="mediumField" promptText="VD: Sơn dầu trên gỗ"
                                      GridPane.columnIndex="1" GridPane.rowIndex="2" prefWidth="480"
                                      style="-fx-pref-height: 40;" />

                            <Label text="Kích thước:" GridPane.columnIndex="0" GridPane.rowIndex="3"
                                   style="-fx-font-size: 14px; -fx-text-fill: #d1d5db; -fx-font-weight: 500; -fx-min-width: 150; -fx-alignment: CENTER_RIGHT;" />
                            <TextField fx:id="dimensionsField" promptText="VD: 77 x 53 cm"
                                      GridPane.columnIndex="1" GridPane.rowIndex="3" prefWidth="480"
                                      style="-fx-pref-height: 40;" />

                            <Label text="Giấy chứng nhận:" GridPane.columnIndex="0" GridPane.rowIndex="4"
                                   style="-fx-font-size: 14px; -fx-text-fill: #d1d5db; -fx-font-weight: 500; -fx-min-width: 150; -fx-alignment: CENTER_RIGHT;" />
                            <TextField fx:id="certificateIdField" promptText="Mã chứng nhận (nếu có)"
                                      GridPane.columnIndex="1" GridPane.rowIndex="4" prefWidth="480"
                                      style="-fx-pref-height: 40;" />

                            <Label text="Đã xác thực?" GridPane.columnIndex="0" GridPane.rowIndex="5"
                                   style="-fx-font-size: 14px; -fx-text-fill: #d1d5db; -fx-font-weight: 500; -fx-min-width: 150; -fx-alignment: CENTER_RIGHT;" />
                            <ComboBox fx:id="authenticatedComboBox" promptText="Chọn trạng thái xác thực"
                                      GridPane.columnIndex="1" GridPane.rowIndex="5" prefWidth="480"
                                      style="-fx-pref-height: 40;" />
                        </GridPane>

                        <!-- Vehicle Fields -->
                        <GridPane fx:id="vehicleGrid" hgap="18" vgap="16" managed="false" visible="false"
                                  style="-fx-padding: 8 0 4 0; -fx-max-width: 780;">
                            <Label text="Loại xe:" GridPane.columnIndex="0" GridPane.rowIndex="0"
                                   style="-fx-font-size: 14px; -fx-text-fill: #d1d5db; -fx-font-weight: 500; -fx-min-width: 150; -fx-alignment: CENTER_RIGHT;" />
                            <ComboBox fx:id="vehicleTypeComboBox" promptText="Chọn loại xe"
                                      GridPane.columnIndex="1" GridPane.rowIndex="0" prefWidth="480"
                                      style="-fx-pref-height: 40;" />

                            <Label text="Hãng xe:" GridPane.columnIndex="0" GridPane.rowIndex="1"
                                   style="-fx-font-size: 14px; -fx-text-fill: #d1d5db; -fx-font-weight: 500; -fx-min-width: 150; -fx-alignment: CENTER_RIGHT;" />
                            <TextField fx:id="makeField" promptText="VD: Toyota"
                                      GridPane.columnIndex="1" GridPane.rowIndex="1" prefWidth="480"
                                      style="-fx-pref-height: 40;" />

                            <Label text="Mẫu xe:" GridPane.columnIndex="0" GridPane.rowIndex="2"
                                   style="-fx-font-size: 14px; -fx-text-fill: #d1d5db; -fx-font-weight: 500; -fx-min-width: 150; -fx-alignment: CENTER_RIGHT;" />
                            <TextField fx:id="vehicleModelField" promptText="VD: Camry"
                                      GridPane.columnIndex="1" GridPane.rowIndex="2" prefWidth="480"
                                      style="-fx-pref-height: 40;" />

                            <Label text="Năm sản xuất:" GridPane.columnIndex="0" GridPane.rowIndex="3"
                                   style="-fx-font-size: 14px; -fx-text-fill: #d1d5db; -fx-font-weight: 500; -fx-min-width: 150; -fx-alignment: CENTER_RIGHT;" />
                            <TextField fx:id="yearField" promptText="VD: 2020"
                                      GridPane.columnIndex="1" GridPane.rowIndex="3" prefWidth="480"
                                      style="-fx-pref-height: 40;" />

                            <Label text="Số km đã đi:" GridPane.columnIndex="0" GridPane.rowIndex="4"
                                   style="-fx-font-size: 14px; -fx-text-fill: #d1d5db; -fx-font-weight: 500; -fx-min-width: 150; -fx-alignment: CENTER_RIGHT;" />
                            <TextField fx:id="mileageField" promptText="VD: 15,000 km"
                                      GridPane.columnIndex="1" GridPane.rowIndex="4" prefWidth="480"
                                      style="-fx-pref-height: 40;" />

                            <Label text="Loại nhiên liệu:" GridPane.columnIndex="0" GridPane.rowIndex="5"
                                   style="-fx-font-size: 14px; -fx-text-fill: #d1d5db; -fx-font-weight: 500; -fx-min-width: 150; -fx-alignment: CENTER_RIGHT;" />
                            <ComboBox fx:id="fuelTypeComboBox" promptText="Chọn loại nhiên liệu"
                                      GridPane.columnIndex="1" GridPane.rowIndex="5" prefWidth="480"
                                      style="-fx-pref-height: 40;" />

                            <Label text="Hộp số:" GridPane.columnIndex="0" GridPane.rowIndex="6"
                                   style="-fx-font-size: 14px; -fx-text-fill: #d1d5db; -fx-font-weight: 500; -fx-min-width: 150; -fx-alignment: CENTER_RIGHT;" />
                            <ComboBox fx:id="transmissionComboBox" promptText="Chọn hộp số"
                                      GridPane.columnIndex="1" GridPane.rowIndex="6" prefWidth="480"
                                      style="-fx-pref-height: 40;" />

                            <Label text="Màu sắc:" GridPane.columnIndex="0" GridPane.rowIndex="7"
                                   style="-fx-font-size: 14px; -fx-text-fill: #d1d5db; -fx-font-weight: 500; -fx-min-width: 150; -fx-alignment: CENTER_RIGHT;" />
                            <TextField fx:id="colorField" promptText="VD: Đen"
                                      GridPane.columnIndex="1" GridPane.rowIndex="7" prefWidth="480"
                                      style="-fx-pref-height: 40;" />

                            <Label text="Biển số:" GridPane.columnIndex="0" GridPane.rowIndex="8"
                                   style="-fx-font-size: 14px; -fx-text-fill: #d1d5db; -fx-font-weight: 500; -fx-min-width: 150; -fx-alignment: CENTER_RIGHT;" />
                            <TextField fx:id="licensePlateField" promptText="VD: 30A-123.45"
                                      GridPane.columnIndex="1" GridPane.rowIndex="8" prefWidth="480"
                                      style="-fx-pref-height: 40;" />

                            <Label text="Giấy tờ hợp lệ?" GridPane.columnIndex="0" GridPane.rowIndex="9"
                                   style="-fx-font-size: 14px; -fx-text-fill: #d1d5db; -fx-font-weight: 500; -fx-min-width: 150; -fx-alignment: CENTER_RIGHT;" />
                            <ComboBox fx:id="hasValidRegistryComboBox" promptText="Chọn tình trạng giấy tờ"
                                      GridPane.columnIndex="1" GridPane.rowIndex="9" prefWidth="480"
                                      style="-fx-pref-height: 40;" />
                        </GridPane>

                        <!-- Action Buttons -->
                        <Region style="-fx-background-color: #374151; -fx-min-height: 1; -fx-max-height: 1; -fx-padding: 0;" />

                        <HBox spacing="16" alignment="CENTER" style="-fx-padding: 8 0 0 0;">
                            <Button text="🗑  Làm Mới Form" styleClass="btn-secondary"
                                    onAction="#handleClearProductForm" />
                            <Button text="📤  Đăng Sản Phẩm" styleClass="btn-primary"
                                    onAction="#handlePostProduct" />
                        </HBox>
                    </VBox>
                </VBox>
            </ScrollPane>
        </Tab>

        <!-- ====== TAB 2: SẢN PHẨM CỦA TÔI ====== -->
        <Tab text="📋 Sản Phẩm Của Tôi" style="-fx-background-color: transparent;"
             styleClass="seller-tab">
            <VBox spacing="0" style="-fx-background-color: transparent; -fx-padding: 24 28 28 28;">
                <!-- Table Section Header -->
                <HBox spacing="12" alignment="CENTER_LEFT"
                      style="-fx-background-color: #1f2937; -fx-background-radius: 14 14 0 0; -fx-padding: 18 28 16 28; -fx-border-color: rgba(59,130,246,0.08); -fx-border-width: 1 1 0 1; -fx-border-radius: 14 14 0 0;">
                    <Label text="📋 Danh Sách Sản Phẩm"
                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #f3f4f6;" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button text="🔄 Làm mới" styleClass="table-refresh-btn"
                            onAction="#handleRefreshMyProducts" />
                </HBox>
                <TableView fx:id="myProductsTable" VBox.vgrow="ALWAYS"
                           style="-fx-background-color: #1a1f2b; -fx-border-color: rgba(59,130,246,0.08); -fx-border-width: 1; -fx-background-radius: 0 0 14 14; -fx-border-radius: 0 0 14 14;">
                    <columns>
                        <TableColumn fx:id="colId" text="Mã SP" minWidth="80">
                            <cellValueFactory><PropertyValueFactory property="id" /></cellValueFactory>
                        </TableColumn>
                        <TableColumn fx:id="colName" text="Tên Sản Phẩm" minWidth="200" styleClass="col-left">
                            <cellValueFactory><PropertyValueFactory property="name" /></cellValueFactory>
                        </TableColumn>
                        <TableColumn fx:id="colBasePrice" text="Giá Khởi Điểm (VND)" minWidth="150" styleClass="col-center">
                            <cellValueFactory><PropertyValueFactory property="basePrice" /></cellValueFactory>
                        </TableColumn>
                        <TableColumn fx:id="colStatus" text="Trạng Thái" minWidth="100">
                            <cellValueFactory><PropertyValueFactory property="status" /></cellValueFactory>
                        </TableColumn>
                    </columns>
                </TableView>
            </VBox>
        </Tab>

        <!-- ====== TAB 3: TẠO PHIÊN ĐẤU GIÁ ====== -->
        <Tab text="🔨 Tạo Phiên Đấu Giá" style="-fx-background-color: transparent;"
             styleClass="seller-tab">
            <ScrollPane fitToWidth="true" fitToHeight="true"
                style="-fx-background-color: transparent; -fx-background: transparent;">
                <VBox spacing="24" alignment="TOP_CENTER"
                      style="-fx-background-color: transparent; -fx-padding: 28 40 40 40;">

                    <!-- Header Banner -->
                    <VBox alignment="CENTER" spacing="6"
                          style="-fx-background-color: #1f2937; -fx-background-radius: 14; -fx-padding: 28 20 24 20; -fx-max-width: 800; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.35), 12, 0, 0, 4);">
                        <Label text="🔨 Tạo Phiên Đấu Giá Mới"
                               style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #ffffff;" />
                        <Label text="Chọn sản phẩm AVAILABLE và thiết lập thời gian đấu giá"
                               style="-fx-font-size: 13px; -fx-text-fill: #9ca3af;" />
                    </VBox>

                    <!-- Form Card -->
                    <VBox spacing="20" alignment="TOP_CENTER"
                          style="-fx-background-color: #1f2937; -fx-background-radius: 14; -fx-padding: 28 32 32 32; -fx-max-width: 800; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.35), 12, 0, 0, 4); -fx-border-color: rgba(59,130,246,0.06); -fx-border-radius: 14; -fx-border-width: 1;">

                        <GridPane hgap="18" vgap="16"
                                  style="-fx-padding: 8 0 4 0; -fx-max-width: 680;">
                            <Label text="Chọn sản phẩm:" GridPane.columnIndex="0" GridPane.rowIndex="0"
                                   style="-fx-font-size: 14px; -fx-text-fill: #d1d5db; -fx-font-weight: 500; -fx-min-width: 150; -fx-alignment: CENTER_RIGHT;" />
                            <ComboBox fx:id="itemComboBox" promptText="— Chọn sản phẩm AVAILABLE —"
                                      GridPane.columnIndex="1" GridPane.rowIndex="0" prefWidth="480"
                                      style="-fx-pref-height: 40;" />

                            <Label text="Thời gian bắt đầu:" GridPane.columnIndex="0" GridPane.rowIndex="1"
                                   style="-fx-font-size: 14px; -fx-text-fill: #d1d5db; -fx-font-weight: 500; -fx-min-width: 150; -fx-alignment: CENTER_RIGHT;" />
                            <HBox alignment="CENTER_LEFT" spacing="10"
                                  GridPane.columnIndex="1" GridPane.rowIndex="1" prefWidth="480">
                                <DatePicker fx:id="startDatePicker" promptText="Chọn ngày bắt đầu"
                                            style="-fx-pref-height: 40; -fx-pref-width: 200;" />
                                <Spinner fx:id="startHourSpinner" editable="true"
                                         style="-fx-pref-height: 40; -fx-pref-width: 70;" />
                                <Label text=":" textFill="WHITE"
                                       style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-padding: 0 2;" />
                                <Spinner fx:id="startMinSpinner" editable="true"
                                         style="-fx-pref-height: 40; -fx-pref-width: 70;" />
                            </HBox>

                            <Label text="Thời gian kết thúc:" GridPane.columnIndex="0" GridPane.rowIndex="2"
                                   style="-fx-font-size: 14px; -fx-text-fill: #d1d5db; -fx-font-weight: 500; -fx-min-width: 150; -fx-alignment: CENTER_RIGHT;" />
                            <HBox alignment="CENTER_LEFT" spacing="10"
                                  GridPane.columnIndex="1" GridPane.rowIndex="2" prefWidth="480">
                                <DatePicker fx:id="endDatePicker" promptText="Chọn ngày kết thúc"
                                            style="-fx-pref-height: 40; -fx-pref-width: 200;" />
                                <Spinner fx:id="endHourSpinner" editable="true"
                                         style="-fx-pref-height: 40; -fx-pref-width: 70;" />
                                <Label text=":" textFill="WHITE"
                                       style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-padding: 0 2;" />
                                <Spinner fx:id="endMinSpinner" editable="true"
                                         style="-fx-pref-height: 40; -fx-pref-width: 70;" />
                            </HBox>

                            <Label text="Anti-Sniping (giây):" GridPane.columnIndex="0" GridPane.rowIndex="3"
                                   style="-fx-font-size: 14px; -fx-text-fill: #d1d5db; -fx-font-weight: 500; -fx-min-width: 150; -fx-alignment: CENTER_RIGHT;" />
                            <TextField fx:id="antiSnipingField" promptText="30  (0 = tắt)"
                                      GridPane.columnIndex="1" GridPane.rowIndex="3" prefWidth="480"
                                      style="-fx-pref-height: 40;" />
                        </GridPane>

                        <Label fx:id="auctionFormMessageLabel" text="" wrapText="true"
                               style="-fx-font-size: 13px; -fx-text-fill: #ef4444; -fx-padding: 4 0;" />

                        <Region style="-fx-background-color: #374151; -fx-min-height: 1; -fx-max-height: 1; -fx-padding: 0;" />

                        <HBox spacing="16" alignment="CENTER" style="-fx-padding: 8 0 0 0;">
                            <Button text="🔄  Tải lại danh sách" styleClass="secondary-button"
                                    onAction="#handleRefreshMyProducts"
                                    style="-fx-font-size: 14px; -fx-padding: 10 24; -fx-background-color: transparent; -fx-text-fill: #9ca3af; -fx-cursor: hand; -fx-border-color: #4b5563; -fx-border-radius: 6; -fx-border-width: 1; -fx-background-radius: 6;" />
                            <Button text="🚀  Tạo Phiên Đấu Giá" styleClass="primary-button"
                                    onAction="#handleCreateAuction"
                                    style="-fx-font-size: 15px; -fx-padding: 12 32; -fx-font-weight: bold;" />
                        </HBox>

                        <!-- Warning Notice -->
                        <HBox spacing="10" alignment="CENTER"
                              style="-fx-background-color: rgba(245,158,11,0.08); -fx-background-radius: 8; -fx-padding: 12 18; -fx-border-color: rgba(245,158,11,0.2); -fx-border-radius: 8; -fx-border-width: 1;">
                            <Label text="⚠️"
                                   style="-fx-font-size: 16px;" />
                            <Label text="Phiên sẽ ở trạng thái PENDING cho đến khi Admin duyệt."
                                   style="-fx-text-fill: #fde68a; -fx-font-size: 13px; -fx-wrap-text: true;" />
                        </HBox>
                    </VBox>
                </VBox>
            </ScrollPane>
        </Tab>

        <!-- ====== TAB 4: PHIÊN ĐẤU GIÁ CỦA TÔI ====== -->
        <Tab text="📊 Phiên Đấu Giá Của Tôi" style="-fx-background-color: transparent;"
             styleClass="seller-tab">
            <VBox spacing="0" style="-fx-background-color: transparent; -fx-padding: 24 28 28 28;">
                <!-- Table Section Header -->
                <HBox spacing="12" alignment="CENTER_LEFT"
                      style="-fx-background-color: #1f2937; -fx-background-radius: 14 14 0 0; -fx-padding: 18 28 16 28; -fx-border-color: rgba(59,130,246,0.08); -fx-border-width: 1 1 0 1; -fx-border-radius: 14 14 0 0;">
                    <Label text="📊 Danh Sách Phiên Đấu Giá"
                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #f3f4f6;" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button text="🔄 Làm mới" styleClass="table-refresh-btn"
                            onAction="#handleRefreshMyAuctions" />
                    <Button text="⛔ Huỷ Phiên" styleClass="table-cancel-btn"
                            onAction="#handleCancelAuction" />
                </HBox>
                <TableView fx:id="myAuctionsTable" VBox.vgrow="ALWAYS"
                           style="-fx-background-color: #1a1f2b; -fx-border-color: rgba(59,130,246,0.08); -fx-border-width: 1; -fx-background-radius: 0 0 14 14; -fx-border-radius: 0 0 14 14;">
                    <columns>
                        <TableColumn fx:id="colAuctionId" text="Mã Phiên" minWidth="80">
                            <cellValueFactory><PropertyValueFactory property="id" /></cellValueFactory>
                        </TableColumn>
                        <TableColumn fx:id="colAuctionItem" text="Sản Phẩm" minWidth="200" styleClass="col-left">
                            <cellValueFactory><PropertyValueFactory property="itemName" /></cellValueFactory>
                        </TableColumn>
                        <TableColumn fx:id="colAuctionPrice" text="Giá Hiện Tại (VND)" minWidth="150" styleClass="col-center">
                            <cellValueFactory><PropertyValueFactory property="currentPrice" /></cellValueFactory>
                        </TableColumn>
                        <TableColumn fx:id="colAuctionStatus" text="Trạng Thái" minWidth="100">
                            <cellValueFactory><PropertyValueFactory property="status" /></cellValueFactory>
                        </TableColumn>
                        <TableColumn fx:id="colAuctionEnd" text="Kết Thúc Lúc" minWidth="160">
                            <cellValueFactory><PropertyValueFactory property="endTime" /></cellValueFactory>
                        </TableColumn>
                    </columns>
                </TableView>
            </VBox>
        </Tab>
    </tabs>
</TabPane>