<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    ============================================================
    ROOT POM - Quản lý toàn bộ dự án Multi-Module
    ============================================================
    groupId   : định danh tổ chức/nhóm, giống "tên miền ngược"
    artifactId: tên dự án cha (parent)
    version   : phiên bản hiện tại của dự án
    packaging : "pom" có nghĩa đây là project cha, không build ra .jar
    ============================================================
  -->
  <groupId>com.auction</groupId>
  <artifactId>online-auction</artifactId>
  <version>1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>Online Auction System</name>
  <description>Hệ thống đấu giá trực tuyến - Java OOP + MySQL + JavaFX</description>

  <!--
    modules: liệt kê các module con trong dự án.
    Maven sẽ build chúng theo đúng thứ tự phụ thuộc.
  -->
  <modules>
    <module>auction-common</module>
    <module>auction-server</module>
    <module>auction-client</module>
  </modules>

  <!-- Định nghĩa phiên bản Java và encoding một lần, áp dụng cho tất cả module -->
  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Khai báo phiên bản thư viện tập trung tại đây để dễ cập nhật -->
    <gson.version>2.10.1</gson.version>
    <mysql.version>9.3.0</mysql.version>
    <junit.version>5.10.2</junit.version>
    <angus-mail.version>2.0.3</angus-mail.version>
  </properties>

  <!--
    dependencyManagement: KHAI BÁO phiên bản thư viện dùng chung.
    Các module con chỉ cần ghi <groupId> + <artifactId>, KHÔNG cần version.
    Giúp tránh xung đột phiên bản (version conflict) giữa các module.
  -->
  <dependencyManagement>
    <dependencies>
      <!-- Gson: thư viện chuyển đổi Java Object <-> JSON (Google) -->
      <dependency>
        <groupId>com.google.code.gson</groupId>
        <artifactId>gson</artifactId>
        <version>${gson.version}</version>
      </dependency>

      <!-- MySQL JDBC: driver kết nối Java với MySQL database -->
      <dependency>
        <groupId>com.mysql</groupId>
        <artifactId>mysql-connector-j</artifactId>
        <version>${mysql.version}</version>
      </dependency>

      <!-- JUnit 5: framework kiểm thử tự động (Unit Test) -->
      <dependency>
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter</artifactId>
        <version>${junit.version}</version>
        <scope>test</scope>
      </dependency>

      <!-- JavaMail API (Angus Mail) -->
      <dependency>
        <groupId>org.eclipse.angus</groupId>
        <artifactId>angus-mail</artifactId>
        <version>${angus-mail.version}</version>
      </dependency>

      <!-- Module auction-common (dùng trong server và client) -->
      <dependency>
        <groupId>com.auction</groupId>
        <artifactId>auction-common</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.12.1</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.2.5</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
