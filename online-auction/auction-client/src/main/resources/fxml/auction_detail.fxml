<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
  ================================================================
  auction_detail.fxml — Phòng Đấu Giá Trực Tiếp (Redesigned)
  ================================================================
  Fixes applied:
  1. ScrollPane outer wrapper: fitToWidth=true, vbarPolicy=ALWAYS
  2. 2-column layout: Left 40% (image + description), Right (bid panel)
  3. Image in bordered StackPane with fitWidth=400, preserveRatio=true
  4. Description label below image (not in right panel)
  5. Viewer count merged into badge row with live pulse dot
  6. Full bid history ListView restored at bottom
  ================================================================
-->
<ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="ALWAYS"
            styleClass="auction-room-scroll"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.auction.client.controller.AuctionDetailController">

    <VBox spacing="0" styleClass="auction-room-root">

        <padding>
            <Insets top="16" right="28" bottom="24" left="28"/>
        </padding>

        <!-- ===== TOOLBAR — Navigation Buttons ===== -->
        <HBox spacing="15" alignment="CENTER_LEFT" styleClass="auction-room-toolbar">
            <Button text="← Quay lại" onAction="#handleBack" styleClass="nav-btn-back"/>
            <Button text="↻ Làm mới" onAction="#handleRefresh" styleClass="nav-btn-refresh"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="notifyButton" text="🔔 Đăng ký thông báo" onAction="#handleRegisterNotification"
                    styleClass="nav-btn-notify"/>
        </HBox>

        <VBox spacing="20" VBox.vgrow="ALWAYS">

            <!-- ===== TOP: 2-COLUMN LAYOUT ===== -->
            <HBox spacing="28" alignment="TOP_LEFT" styleClass="auction-room-top">

                <!-- ===== LEFT COLUMN: Image + Description (~40%) ===== -->
                <VBox spacing="16" prefWidth="450" maxWidth="460">

                    <!-- Image frame -->
                    <StackPane styleClass="auction-image-frame" minWidth="340" prefWidth="420">
                        <ImageView fx:id="productImageView" fitWidth="400" fitHeight="280"
                                   preserveRatio="true" styleClass="auction-product-image"/>
                    </StackPane>

                    <!-- Product Description Card -->
                    <VBox spacing="10" styleClass="auction-desc-card" VBox.vgrow="ALWAYS">
                        <Label text="📋 Mô tả chi tiết sản phẩm" styleClass="auction-desc-heading"/>
                        <Label fx:id="descriptionLabel" text="Đang tải..." styleClass="auction-desc-text" wrapText="true"
                               VBox.vgrow="ALWAYS"/>
                    </VBox>
                </VBox>

                <!-- ===== RIGHT COLUMN: Live Panel (~60%) ===== -->
                <VBox spacing="16" HBox.hgrow="ALWAYS" styleClass="auction-live-panel">

                    <!-- Merged Badge Row: Live dot + Status + Viewers -->
                    <HBox spacing="12" alignment="CENTER_LEFT" styleClass="auction-badge-row">
                        <HBox spacing="8" alignment="CENTER_LEFT" styleClass="live-viewer-group">
                            <Region fx:id="livePulseDot" styleClass="live-pulse-dot" managed="false" visible="false"/>
                            <Label fx:id="statusBadgeLabel" text="" styleClass="auction-status-badge"/>
                            <Label text="·" style="-fx-text-fill: #4b5563; -fx-font-size: 14px;"/>
                            <Label fx:id="viewerCountLabel" text="Đang tải..." styleClass="viewer-text"/>
                        </HBox>
                    </HBox>

                    <!-- Product Title -->
                    <Label fx:id="titleLabel" text="Đang tải..." styleClass="auction-product-title" wrapText="true"/>

                    <!-- Price Hero -->
                    <VBox spacing="4" styleClass="auction-price-hero">
                        <Label text="Giá hiện tại" styleClass="auction-price-caption"/>
                        <Label fx:id="priceLabel" text="-" styleClass="auction-current-price"/>
                        <Label fx:id="leaderLabel" text="👑 Chưa có người đặt giá" styleClass="auction-leader-label"/>
                    </VBox>

                    <!-- Countdown Card -->
                    <VBox spacing="8" styleClass="auction-countdown-card">
                        <Label fx:id="countdownLabel" text="⏳ Đang tải..." styleClass="auction-countdown-text"/>
                        <HBox maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS">
                            <ProgressBar fx:id="timeProgressBar" progress="1.0" maxWidth="1.7976931348623157E308"
                                         HBox.hgrow="ALWAYS" styleClass="auction-time-progress"/>
                        </HBox>
                        <HBox spacing="16">
                            <Label fx:id="startTimeLabel" text="📅 Khai mạc: -" styleClass="auction-meta-label"/>
                            <Label fx:id="endTimeLabel" text="🏁 Kết thúc: -" styleClass="auction-meta-label"/>
                        </HBox>
                        <Label fx:id="sellerLabel" text="👤 Người bán: -" styleClass="auction-meta-label"/>
                    </VBox>

                    <!-- Bid Panel -->
                    <VBox fx:id="bidPanel" spacing="12" styleClass="auction-bid-panel">

                        <Label text="Đặt giá ngay" styleClass="auction-bid-panel-title"/>

                        <Label fx:id="minBidHintLabel" text="Giá tối thiểu: -" styleClass="auction-bid-hint"/>

                        <FlowPane hgap="10" vgap="8" styleClass="auction-preset-flow">
                            <Button fx:id="preset1Btn" text="+100K" onAction="#handlePreset1" styleClass="auction-preset-btn"/>
                            <Button fx:id="preset2Btn" text="+500K" onAction="#handlePreset2" styleClass="auction-preset-btn"/>
                            <Button fx:id="preset3Btn" text="+1M" onAction="#handlePreset3" styleClass="auction-preset-btn"/>
                            <Button fx:id="preset4Btn" text="+5M" onAction="#handlePreset4" styleClass="auction-preset-btn"/>
                            <Button fx:id="preset5Btn" text="+10M" onAction="#handlePreset5" styleClass="auction-preset-btn"/>
                        </FlowPane>

                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <TextField fx:id="bidAmountField" promptText="Nhập số tiền (VND)..."
                                       styleClass="auction-bid-field" HBox.hgrow="ALWAYS"/>
                            <Button fx:id="submitBidBtn" text="ĐẶT GIÁ" onAction="#handleSubmitBid"
                                    styleClass="auction-submit-bid-btn" minWidth="160"/>
                        </HBox>

                        <Label fx:id="bidStatusLabel" text="" styleClass="auction-bid-status" wrapText="true"/>
                    </VBox>
                </VBox>
            </HBox>

            <!-- ===== BOTTOM: Bid History ===== -->
            <VBox spacing="10" VBox.vgrow="ALWAYS" styleClass="auction-history-section">
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="📊 Lịch sử đặt giá" styleClass="auction-section-heading"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="Giá cao nhất được đánh dấu vàng" styleClass="auction-history-hint"/>
                </HBox>

                <ListView fx:id="bidHistoryList" prefHeight="300" minHeight="200"
                          styleClass="auction-bid-history-list" VBox.vgrow="ALWAYS"/>
            </VBox>

        </VBox>
    </VBox>
</ScrollPane>