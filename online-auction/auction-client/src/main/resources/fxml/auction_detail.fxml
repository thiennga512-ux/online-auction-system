<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>

<HBox spacing="24" styleClass="root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.auction.client.controller.AuctionDetailController">
    <padding>
        <Insets top="20" right="32" bottom="20" left="32"/>
    </padding>

    <!-- ===== CỘT TRÁI: Ảnh + Thông tin + Thao tác ===== -->
    <VBox spacing="14" prefWidth="380">

        <!-- Nút điều hướng -->
        <HBox spacing="10">
            <Button text="← Quay lại" onAction="#handleBack"
                    style="-fx-background-color: #374151; -fx-text-fill: white; -fx-background-radius: 6; -fx-padding: 7 14; -fx-cursor: hand;"/>
            <Button text="🔄 Làm mới" styleClass="primary-button" onAction="#handleRefresh"/>
            <Button fx:id="notifyButton" text="🔔 Đăng ký thông báo" onAction="#handleRegisterNotification"
                    style="-fx-background-color: #374151; -fx-text-fill: #9ca3af; -fx-background-radius: 6; -fx-padding: 7 14; -fx-cursor: hand;"/>
        </HBox>

        <!-- Badge trạng thái -->
        <Label fx:id="statusBadgeLabel" text=""
               style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 5 12; -fx-background-radius: 20; -fx-border-radius: 20;"/>

        <!-- Ảnh sản phẩm -->
        <StackPane style="-fx-background-color: #1f2937; -fx-background-radius: 12;" minHeight="220">
            <ImageView fx:id="productImageView" fitWidth="360" fitHeight="220" preserveRatio="true"/>
        </StackPane>

        <!-- Tên sản phẩm -->
        <Label fx:id="titleLabel" text="Đang tải..." styleClass="title-text"
               style="-fx-font-size: 22px; -fx-wrap-text: true;" wrapText="true"/>

        <!-- Mô tả sản phẩm -->
        <Label fx:id="descriptionLabel" text=""
               style="-fx-text-fill: #9ca3af; -fx-font-size: 13px; -fx-wrap-text: true;"
               wrapText="true"/>

        <!-- Giá hiện tại -->
        <Label fx:id="priceLabel" text="Giá hiện tại: -"
               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #10b981;"/>

        <!-- Người dẫn đầu -->
        <Label fx:id="leaderLabel" text="👑 Chưa có người đặt giá"
               style="-fx-font-size: 14px; -fx-text-fill: #fbbf24;"/>

        <Separator style="-fx-background-color: #374151;"/>

        <!-- Thông tin thời gian -->
        <VBox spacing="6" style="-fx-background-color: #1f2937; -fx-background-radius: 10; -fx-padding: 14;">

            <!-- Đếm ngược chính (thay đổi tuỳ OPEN/RUNNING) -->
            <Label fx:id="countdownLabel" text="⏳ Đang tải..."
                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #60a5fa;"/>

            <!-- Thời gian cụ thể -->
            <Label fx:id="startTimeLabel" text="📅 Khai mạc: -"
                   style="-fx-font-size: 12px; -fx-text-fill: #6b7280;"/>
            <Label fx:id="endTimeLabel" text="🏁 Kết thúc: -"
                   style="-fx-font-size: 12px; -fx-text-fill: #6b7280;"/>
        </VBox>

        <!-- Người bán -->
        <Label fx:id="sellerLabel" text="👤 Người bán: -"
               style="-fx-font-size: 13px; -fx-text-fill: #9ca3af;"/>

    </VBox>

    <!-- ===== CỘT PHẢI: Đặt giá + Lịch sử bid ===== -->
    <VBox spacing="14" HBox.hgrow="ALWAYS">

        <!-- ===== KHU VỰC ĐẶT GIÁ ===== -->
        <VBox fx:id="bidPanel" spacing="12"
              style="-fx-background-color: #1f2937; -fx-background-radius: 12; -fx-padding: 18;">

            <Label text="🏷 Đặt giá"
                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;"/>

            <!-- Gợi ý giá tối thiểu -->
            <Label fx:id="minBidHintLabel" text="Giá tối thiểu: -"
                   style="-fx-font-size: 13px; -fx-text-fill: #9ca3af;"/>

            <!-- Preset nhanh -->
            <FlowPane hgap="8" vgap="8">
                <Button fx:id="preset1Btn" text="+100K" onAction="#handlePreset1"
                        style="-fx-background-color: #374151; -fx-text-fill: #d1d5db; -fx-background-radius: 6; -fx-padding: 6 12; -fx-cursor: hand; -fx-font-size: 12px;"/>
                <Button fx:id="preset2Btn" text="+500K" onAction="#handlePreset2"
                        style="-fx-background-color: #374151; -fx-text-fill: #d1d5db; -fx-background-radius: 6; -fx-padding: 6 12; -fx-cursor: hand; -fx-font-size: 12px;"/>
                <Button fx:id="preset3Btn" text="+1M" onAction="#handlePreset3"
                        style="-fx-background-color: #374151; -fx-text-fill: #d1d5db; -fx-background-radius: 6; -fx-padding: 6 12; -fx-cursor: hand; -fx-font-size: 12px;"/>
                <Button fx:id="preset4Btn" text="+5M" onAction="#handlePreset4"
                        style="-fx-background-color: #374151; -fx-text-fill: #d1d5db; -fx-background-radius: 6; -fx-padding: 6 12; -fx-cursor: hand; -fx-font-size: 12px;"/>
                <Button fx:id="preset5Btn" text="+10M" onAction="#handlePreset5"
                        style="-fx-background-color: #374151; -fx-text-fill: #d1d5db; -fx-background-radius: 6; -fx-padding: 6 12; -fx-cursor: hand; -fx-font-size: 12px;"/>
            </FlowPane>

            <!-- Ô nhập giá + nút xác nhận -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="bidAmountField"
                           promptText="Nhập số tiền (VND)..."
                           style="-fx-background-color: #111827; -fx-text-fill: white; -fx-prompt-text-fill: #6b7280; -fx-border-color: #374151; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10 14; -fx-font-size: 14px;"
                           HBox.hgrow="ALWAYS"/>
                <Button fx:id="submitBidBtn" text="✅ Đặt giá" onAction="#handleSubmitBid"
                        style="-fx-background-color: #10b981; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 20; -fx-cursor: hand; -fx-font-size: 14px;"/>
            </HBox>

            <!-- Thông báo lỗi / trạng thái -->
            <Label fx:id="bidStatusLabel" text=""
                   style="-fx-font-size: 12px; -fx-text-fill: #ef4444;" wrapText="true"/>

        </VBox>

        <Separator style="-fx-background-color: #374151;"/>

        <!-- ===== LỊCH SỬ BID ===== -->
        <Label text="📋 Lịch sử đặt giá" styleClass="title-text" style="-fx-font-size: 18px;"/>
        <ListView fx:id="bidHistoryList" VBox.vgrow="ALWAYS"
                  style="-fx-background-color: #1f2937; -fx-border-color: #374151; -fx-border-radius: 8; -fx-background-radius: 8;"/>
    </VBox>

</HBox>
