<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20" styleClass="root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.controller.HomeController">
    <padding>
        <Insets bottom="20" left="40" right="40" top="20" />
    </padding>

    <!-- Banner nổi bật -->
    <VBox alignment="CENTER" styleClass="card-container" style="-fx-padding: 40; -fx-background-color: linear-gradient(to right, #1e3a8a, #3b82f6);">
        <Label text="KHÁM PHÁ CÁC SẢN PHẨM ĐẤU GIÁ HOT NHẤT" styleClass="title-text" style="-fx-font-size: 32px;" />
        <Label text="Đăng nhập để tham gia đặt giá ngay hôm nay!" styleClass="subtitle-text" style="-fx-text-fill: #e5e7eb;" />
    </VBox>

    <!-- Search Bar Capsule -->
    <VBox fx:id="searchContainer" spacing="8" alignment="TOP_CENTER" style="-fx-padding: 0;">
        <HBox alignment="CENTER" spacing="12" style="-fx-padding: 16 24; -fx-background-color: rgba(31, 41, 55, 0.6); -fx-background-radius: 999; -fx-border-color: rgba(75, 85, 99, 0.4); -fx-border-width: 1; -fx-border-radius: 999; -fx-effect: dropshadow(gaussian, rgba(0, 0, 0, 0.15), 8, 0, 0, 2);">
            <Label text="🔍" style="-fx-font-size: 18px; -fx-text-fill: #3b82f6;" />
            <TextField fx:id="searchInput" promptText="Tìm kiếm tài sản đấu giá..." style="-fx-background-color: transparent; -fx-text-fill: #ffffff; -fx-prompt-text-fill: #9ca3af; -fx-font-size: 14px; -fx-padding: 0; -fx-border-width: 0;" HBox.hgrow="ALWAYS" />
            <Button fx:id="searchButton" text="Tìm kiếm" styleClass="primary-button" style="-fx-padding: 8 20; -fx-font-size: 13px;" />
        </HBox>
        <Label fx:id="searchErrorLabel" style="-fx-text-fill: #ef4444; -fx-font-size: 12px; -fx-padding: 0 24;" />
    </VBox>

    <Label text="Danh mục sản phẩm" styleClass="subtitle-text" style="-fx-font-size: 16px; -fx-text-fill: #d1d5db;" />
    <HBox fx:id="categoryRow" alignment="CENTER" spacing="20" style="-fx-padding: 0 24;">
        <VBox fx:id="allCategoryItem" styleClass="category-item" userData="ALL" onMouseClicked="#onCategoryClicked">
            <Label text="📦" styleClass="category-circle" />
            <Label text="Tất cả" styleClass="category-name" />
        </VBox>
        <VBox fx:id="electronicsCategoryItem" styleClass="category-item" userData="ELECTRONICS" onMouseClicked="#onCategoryClicked">
            <Label text="📱" styleClass="category-circle" />
            <Label text="Electronic" styleClass="category-name" />
        </VBox>
        <VBox fx:id="artCategoryItem" styleClass="category-item" userData="ART" onMouseClicked="#onCategoryClicked">
            <Label text="🎨" styleClass="category-circle" />
            <Label text="Art" styleClass="category-name" />
        </VBox>
        <VBox fx:id="vehicleCategoryItem" styleClass="category-item" userData="VEHICLE" onMouseClicked="#onCategoryClicked">
            <Label text="🚗" styleClass="category-circle" />
            <Label text="Vehicle" styleClass="category-name" />
        </VBox>
    </HBox>

    <Label text="Phiên đấu giá đang diễn ra" styleClass="title-text" style="-fx-font-size: 24px;" />

    <ScrollPane fx:id="auctionScrollPane" fitToWidth="true" style="-fx-background-color: transparent;" stylesheets="@../css/style.css">
        <!-- Vùng chứa lưới sản phẩm -->
        <FlowPane fx:id="productsGrid" hgap="20" vgap="20" alignment="TOP_LEFT" />
    </ScrollPane>
</VBox>
