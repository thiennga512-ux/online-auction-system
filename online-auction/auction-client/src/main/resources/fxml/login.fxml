<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="rootContainer" alignment="CENTER" spacing="0" styleClass="root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.controller.LoginController" prefWidth="800" prefHeight="600">
    <VBox alignment="CENTER" spacing="20" styleClass="card-container" maxWidth="400">
        <padding>
            <Insets bottom="40" left="40" right="40" top="40" />
        </padding>

        <VBox alignment="CENTER" spacing="5">
            <Label styleClass="title-text" text="ONLINE AUCTION" />
            <Label styleClass="subtitle-text" text="Đăng nhập để bắt đầu đặt giá" />
        </VBox>

        <VBox spacing="10">
            <Label text="Email" />
            <TextField fx:id="emailField" promptText="nhap_email@domain.com" />
            
            <Label text="Mật khẩu" />
            <PasswordField fx:id="passwordField" promptText="••••••••" />
        </VBox>

        <Label fx:id="errorLabel" styleClass="error-text" text="" wrapText="true" visible="false" />

        <Button fx:id="loginButton" maxWidth="Infinity" styleClass="primary-button" text="ĐĂNG NHẬP" onAction="#handleLogin" />

        <Button styleClass="secondary-button" text="Chưa có tài khoản? Đăng ký ngay" onAction="#goToRegister" />

        <!-- Liên kết chuyển sang Admin Login -->
        <Hyperlink fx:id="adminLoginLink" styleClass="admin-login-link" text="Dành cho Quản trị viên" onAction="#goToAdminLogin" />
    </VBox>
</VBox>